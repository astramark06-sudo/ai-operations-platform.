# 21st.dev free account token (optional; free tier has daily retrieval limits).
API_KEY_21ST=

# Full MCP URL copied from Penpot → Account → Integrations → MCP Server.
# This URL contains your private MCP key. Keep it in .env or your local shell environment.
PENPOT_MCP_URL=

# Strix uses a local Ollama model; no paid model API key.
STRIX_LLM=ollama/qwen3-vl
LLM_API_BASE=http://localhost:11434
